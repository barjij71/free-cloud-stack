{
  "name": "free-cloud-stack",
  "private": true,
  "workspaces": ["apps/*"],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run dev --workspace=apps/api",
    "build": "npm run build --workspaces",
    "deploy:web": "npm run deploy --workspace=apps/web",
    "deploy:api": "npm run deploy --workspace=apps/api",
    "cf:login": "wrangler login",
    "cf:pages:deploy": "wrangler pages deploy apps/web/.output/public --project-name=free-cloud-web",
    "cf:worker:deploy": "wrangler deploy --config apps/api/wrangler.toml"
  },
  "devDependencies": {
    "wrangler": "^3.0.0"
  }
}